# All settings are optional. Relative paths are from this folder.

# The library database: your games and files. Created if it doesn't exist.
# Default: data/library.db
LIBRARY_DB_PATH=

# The No-Intro/Redump reference database, filled by `bun run import:dats`.
# Default: data/dats.db
LIBRARY_DATS_PATH=

# Your ROM folders, separated by ":" (";" on Windows). Each folder, or each
# folder inside it, named like a platform (snes, megadrive, psx, "Super
# Nintendo Entertainment System", ...) is scanned by `bun run scan`.
# Default: data/roms
LIBRARY_ROM_ROOTS=

# Platforms for folder names the scanner doesn't know, as "folder=platform"
# pairs separated by ";", by platform slug or name. For example:
# LIBRARY_ROM_PLATFORMS=My SNES games=snes;Genesis Collection=megadrive
LIBRARY_ROM_PLATFORMS=

# Folder for downloaded artwork, which cards show. Default: data/media
LIBRARY_MEDIA_PATH=

# Whose box art cards show when a game has several, best first. Default:
# North America,USA,World,Europe,United Kingdom,Japan
LIBRARY_ART_REGIONS=
