# Path to the library database (SQLite), relative to this folder. It is
# created empty, with the schema, if it doesn't exist. Default: data/library.db
LIBRARY_DB_PATH=

# Folder for downloaded artwork, relative to this folder. Default: data/media
LIBRARY_MEDIA_PATH=

# Whose box art cards show when a game has several, best first. Default:
# North America,United States,World,Europe,United Kingdom,Japan
LIBRARY_ART_REGIONS=
