{
  "name": "beamrider-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "bun check",
    "import:dats": "bun scripts/import-dats.ts",
    "scan": "bun scripts/scan.ts"
  },
  "dependencies": {
    "7z-wasm": "1.2.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
